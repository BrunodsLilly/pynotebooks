{
	"image": "mcr.microsoft.com/devcontainers/universal:2",
	"features": {
		"ghcr.io/va-h/devcontainers-features/uv:1": {
			"shellautocompletion": true,
			"version": "latest"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"vim.enableVim": true,
				"terminal.integrated.defaultProfile.linux": "zsh"
			}
		}
	}
}